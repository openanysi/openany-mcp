    "cordis.patch.yml",
    "plugins/deepseek-harness/index.js",
    "plugins/deepseek-harness/icon.svg",
    "plugins/deepseek-harness/README.md",
    "plugins/deepseek-harness/DETAIL.md",
    "locale/en.json",
    "locale/zh.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./plugins/deepseek-harness/icon.svg",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
