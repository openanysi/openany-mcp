{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "si.openany/seo",
  "title": "Google Keyword Checker",
  "version": "0.1.0",
  "description": "Keyword research via DataForSEO: Google/Bing volume, difficulty, ideas, ranked keywords, SERP.",
  "websiteUrl": "https://openany.si",
  "repository": {
    "url": "https://github.com/openanysi/openany-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://seo.openany.si",
      "headers": [
        {
          "name": "Authorization",
          "description": "OpenAny API key as Bearer token. Optional for the price check; required before a confirmed paid call.",
          "isRequired": false,
          "isSecret": true,
          "value": "Bearer {OPENANY_API_KEY}",
          "variables": {
            "OPENANY_API_KEY": {
              "description": "OpenAny API key",
              "isRequired": false,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
