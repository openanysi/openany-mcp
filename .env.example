# Runtime credential must have SELECT only. Do not use the maintenance role here.
POSTGRES_DATABASE_URL=postgres://openany_mcp_reader:CHANGE_ME@127.0.0.1:5432/openany_local
OPENANY_GATEWAY_BASE_URL=http://127.0.0.1:8888
MCP_LISTEN_ADDR=127.0.0.1:3333
MCP_PUBLIC_HOSTS=127.0.0.1:3333,localhost:3333
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3333,http://localhost:3333
MCP_CATALOG_OVERRIDES_FILE=config/catalog-overrides.json
MCP_CATALOG_REFRESH_INTERVAL=30s
MCP_CATALOG_MAX_STALENESS=120s
MCP_DATABASE_QUERY_TIMEOUT=10s
MCP_DATABASE_MAX_CONNS=4
MCP_GATEWAY_TIMEOUT=1260s
MCP_GATEWAY_CONNECT_TIMEOUT=5s
MCP_MAX_CONCURRENT_CALLS=16
MCP_REQUEST_MAX_BYTES=8388608
MCP_GATEWAY_RESPONSE_MAX_BYTES=8388608
MCP_RESULT_MAX_BYTES=20971520
MCP_SHUTDOWN_TIMEOUT=1300s

# Additive discovery endpoint; existing /mcp and provider URLs remain available.
MCP_LITE_ENABLED=false
